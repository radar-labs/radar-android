    <color name="radar_accent_blue">#0069FE</color>
    <!-- Label color on the accent-blue "I'm new to Radar" welcome button. -->
    <color name="radar_accent_blue_on">#A2FDFF</color>
    <!-- iOS segmented-switcher track color. -->
    <color name="radar_segmented_track">#E9E9EA</color>
    <!-- iOS grayFill = rgba(120,120,128,0.16) — used for pill buttons / fields. -->
