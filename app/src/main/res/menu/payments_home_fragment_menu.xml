<?xml version="1.0" encoding="utf-8"?>
<!--
  Payments-home toolbar menu. The individual settings rows (Set currency, Bitcoin
  unit, Payments username, Recovery phrase, Help, Lightning logs, Deactivate,
  Delete wallet) now live behind the trailing gear, which opens
  PaymentSettingsMenuFragment (mirrors iOS PaymentSettingsMenuViewController).
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Hide/show-balance toggle. Shown as a leading icon button in the toolbar in standalone
         mode (PaymentsActivity); programmatically hidden in tab mode where the same toggle
         is placed on the LEFT as the toolbar's navigation icon (mirrors iOS leftBarButtonItem). -->
    <item android:id="@+id/payments_home_fragment_menu_balance_visibility"
        android:title="@string/PaymentsHomeFragment__toggle_balance_visibility"
        android:icon="@drawable/ic_visibility_24dp"
        app:showAsAction="always" />

    <!-- Trailing gear → Payment settings disclosure list. -->
    <item android:id="@+id/payments_home_fragment_menu_settings"
        android:title="@string/PaymentsHomeFragment__payment_settings"
        android:icon="@drawable/symbol_settings_android_24"
        app:showAsAction="always" />
</menu>
