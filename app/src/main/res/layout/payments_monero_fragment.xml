<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/monero_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/PaymentsMonero__payments" />
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/monero_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@id/monero_currency_selected">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/monero_currency_bitcoin"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/PaymentsMonero__bitcoin" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/monero_currency_selected"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/PaymentsMonero__open_wallet" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView
                    android:id="@+id/monero_balance"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:text="@string/PaymentsMonero__unknown_balance"
                    android:textAppearance="@style/Signal.Text.Body"
                    android:textSize="40sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="16sp"
                    android:autoSizeMaxTextSize="40sp" />
                <TextView
                    android:id="@+id/monero_balance_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:textAppearance="@style/Signal.Text.MaterialCaption" />
                <org.thoughtcrime.securesms.components.PaymentPillStrip
                    android:id="@+id/monero_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <include layout="@layout/payment_pill_strip" />
                </org.thoughtcrime.securesms.components.PaymentPillStrip>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/monero_create"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/PaymentsMonero__create"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/monero_restore"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/PaymentsMonero__restore"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/monero_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="20dp"
                    android:textAppearance="@style/Signal.Text.MaterialCaption" />
                <ProgressBar
                    android:id="@+id/monero_sync_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/monero_sync_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:textAppearance="@style/Signal.Text.MaterialCaption"
                    android:visibility="gone" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/PaymentsMonero__transactions"
                        android:textAppearance="@style/Signal.Text.TitleMedium" />
                    <TextView
                        android:id="@+id/monero_transaction_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Signal.Text.MaterialCaption"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/monero_transactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
