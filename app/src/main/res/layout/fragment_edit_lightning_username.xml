<?xml version="1.0" encoding="utf-8"?>
<!--
  Edit lightning-username (a.k.a. Radar username) screen.

  Mirrors iOS RadarUsernameViewController.swift:
    - radar-logo (82dp) → title2-semibold "Your Radar Username"
    - subtitle (50% alpha) → 32dp gap
    - input row: gray-fill pill (radius 26, height 52) + "@radar.cash" accent semibold
    - status label (footnote, hidden until check)
    - flexible spacer
    - Confirm (accent-blue capsule, radius 14, height 52)
    - Cancel (borderless accent-blue text)

  Top margin 48dp / horizontal 36dp matches iOS layoutMargins.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <androidx.appcompat.widget.Toolbar
      android:id="@+id/edit_lightning_username_toolbar"
      android:layout_width="match_parent"
      android:layout_height="@dimen/signal_m3_toolbar_height"
      android:minHeight="@dimen/signal_m3_toolbar_height"
      app:navigationIcon="@drawable/symbol_arrow_start_24" />

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true"
      android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp">

      <ImageView
          android:layout_width="82dp"
          android:layout_height="82dp"
          android:layout_gravity="center_horizontal"
          android:contentDescription="@null"
          android:scaleType="fitCenter"
          android:src="@drawable/radar_logo" />

      <Space
          android:layout_width="match_parent"
          android:layout_height="24dp" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:text="@string/EditLightningUsernameFragment__title"
          android:textColor="@color/signal_text_primary"
          android:textSize="22sp"
          android:textStyle="bold" />

      <Space
          android:layout_width="match_parent"
          android:layout_height="8dp" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.5"
          android:gravity="center"
          android:text="@string/EditLightningUsernameFragment__subtitle"
          android:textColor="@color/signal_text_primary"
          android:textSize="15sp" />

      <Space
          android:layout_width="match_parent"
          android:layout_height="32dp" />

      <!-- Input row: gray pill + "@radar.cash" accent label -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_radar_username_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

          <EditText
              android:id="@+id/edit_lightning_username_field"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:autofillHints="username"
              android:background="@null"
              android:hint="@string/EditLightningUsernameFragment__username_hint"
              android:imeOptions="actionDone"
              android:importantForAutofill="no"
              android:inputType="text|textNoSuggestions"
              android:maxLength="24"
              android:maxLines="1"
              android:singleLine="true"
              android:textColor="@color/signal_text_primary"
              android:textColorHint="@color/signal_text_secondary"
              android:textSize="16sp" />

          <ImageButton
              android:id="@+id/edit_lightning_username_clear"
              android:layout_width="32dp"
              android:layout_height="32dp"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@null"
              android:padding="6dp"
              android:src="@drawable/symbol_x_24"
              android:visibility="gone"
              app:tint="@color/signal_text_secondary"
              tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="\@radar.cash"
            android:textColor="@color/radar_accent_blue"
            android:textSize="16sp"
            android:textStyle="bold" />

      </LinearLayout>

      <Space
          android:layout_width="match_parent"
          android:layout_height="8dp" />

      <TextView
          android:id="@+id/edit_lightning_username_status"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:textSize="13sp"
          android:visibility="gone"
          tools:text="✓ Username available"
          tools:visibility="visible" />

      <Space
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/edit_lightning_username_confirm"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:backgroundTint="@color/radar_accent_blue"
          android:enabled="false"
          android:insetTop="0dp"
          android:insetBottom="0dp"
          android:text="@string/EditLightningUsernameFragment__confirm"
          android:textAllCaps="false"
          android:textColor="@android:color/white"
          android:textSize="17sp"
          android:textStyle="bold"
          app:cornerRadius="14dp" />

      <Space
          android:layout_width="match_parent"
          android:layout_height="16dp" />

      <TextView
          android:id="@+id/edit_lightning_username_skip"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:gravity="center"
          android:paddingTop="12dp"
          android:paddingBottom="12dp"
          android:text="@string/EditLightningUsernameFragment__skip"
          android:textColor="@color/radar_accent_blue"
          android:textSize="15sp"
          android:textStyle="bold" />

    </LinearLayout>

  </ScrollView>

</LinearLayout>
